{
  "name": "manjira-tracker",
  "description": "AI-powered rhythm learning platform for Manjira strikes",
  "author": "Manjira Tracker",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs --production",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "app": "electron .",
    "app:dev": "concurrently -k \"npm run dev\" \"wait-on http-get://127.0.0.1:3000 && electron . --dev\"",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http-get://127.0.0.1:3000 && electron . --dev\"",
    "electron:pack": "npm run build && electron-builder --win portable",
    "electron:dist": "npm run build && electron-builder --win nsis",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build",
    "test:desktop": "node scripts/desktop-smoke.cjs"
  },
  "build": {
    "appId": "com.manjira.tracker",
    "productName": "Manjira Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tone": "^15.1.22",
    "vite": "^6.2.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
